# Speech-to-Text Provider: 'openai' (using Whisper) or 'google' (using Chirp 2)
STT_PROVIDER=openai
STT_MODEL=whisper-1
OPENAI_API_KEY=your-openai-api-key

# Google Cloud Configuration (if using google STT)
GCP_PROJECT_ID=your-gcp-project-id
STT_LOCATION=asia-southeast1

# Gemini Configuration (Gemini API key from Google AI Studio)
GEMINI_MODEL_ID=gemini-3.8-flash
GEMINI_API_KEY=your-gemini-api-key

# Constraints
MAX_AUDIO_SECONDS=55
MAX_AUDIO_BYTES=1800000
LOG_REQUEST_BODIES=false
