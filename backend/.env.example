# Google Cloud Configuration
GCP_PROJECT_ID=your-gcp-project-id
STT_LOCATION=asia-southeast1
STT_MODEL=chirp_2

# Speech-to-Text V2 Credentials
# Note: Google Cloud Speech-to-Text V2 requires Application Default Credentials (OAuth2/Service Account).
# For local testing, download a service account JSON key from GCP IAM and set its path here:
GOOGLE_APPLICATION_CREDENTIALS=service_account.json

# Gemini Configuration (Gemini API key from Google AI Studio)
GEMINI_MODEL_ID=gemini-3.8-flash
GEMINI_API_KEY=your-gemini-api-key

# Constraints
MAX_AUDIO_SECONDS=55
MAX_AUDIO_BYTES=1800000
LOG_REQUEST_BODIES=false
